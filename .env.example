# ============================================================
# 灵犀采购 LingXi-Procure · 环境变量样例
# 使用方法：cp .env.example .env 后填入自己的配置
# ============================================================

# ---------- MySQL（DB_HOST 留空则退化为本地 SQLite，零依赖演示）----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=lingxi_procurement

# ---------- Redis（会话/行情缓存、任务并发、SSE 进度通道）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# LangGraph Checkpoint 直接消费该 URL；留空则使用上面的分项拼出
# 6379 = 本地 Redis（无 RediSearch 模块，不能用于 Checkpoint）
# 6380 = redis-stack-server（自带 RediSearch）
REDIS_URL=redis://127.0.0.1:6380/0

# ---------- LLM（OpenAI 兼容接口，默认阿里云百炼）----------
DASHSCOPE_API_KEY=your_dashscope_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=

# ---------- Chroma 向量库 ----------
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=lingxi_kb

# ---------- 数据文件路径 ----------
MARKET_CSV=./data/commodity_price.csv
SUPPLIER_CSV=./data/supplier.csv
KB_DOCS_DIR=./data/kb

# ---------- 服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
